# Copy to .env for local development. In production, set these in Vercel:
# Project Settings > Environment Variables.

# Sanity: from sanity.io/manage. These are public and safe to expose.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Supabase: from Project Settings > API. Keep the service role key secret.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
