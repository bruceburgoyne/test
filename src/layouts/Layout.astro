---
import { getSiteSettings } from '../lib/content.js';

const { title, description, current, showHeaderCta = true } = Astro.props;
const settings = await getSiteSettings();
const pages = [
  { href: '/', label: 'Home', id: 'home' },
  { href: '/about', label: 'About', id: 'about' },
  { href: '/contact', label: 'Contact', id: 'contact' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title} | {settings.siteName}</title>
  {description && <meta name="description" content={description}>}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Bodoni:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Public+Sans:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/styles.css">
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="wordmark" href="/">{settings.siteName}</a>
      <nav aria-label="Main">
        <ul class="nav">
          {pages.map((page) => (
            <li><a href={page.href} aria-current={page.id === current ? 'page' : undefined}>{page.label}</a></li>
          ))}
        </ul>
      </nav>
      {showHeaderCta && <a class="button button-small header-cta" href="/contact">Start a conversation</a>}
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <a class="wordmark" href="/">{settings.siteName}</a>
        {settings.footerNote && <p class="footer-note">{settings.footerNote}</p>}
      </div>
      <nav aria-label="Footer">
        <p class="footer-label">Pages</p>
        <ul class="footer-links">
          {pages.map((page) => <li><a href={page.href}>{page.label}</a></li>)}
        </ul>
      </nav>
      {settings.email && (
        <div>
          <p class="footer-label">Get in touch</p>
          <a class="footer-email" href={`mailto:${settings.email}`}>{settings.email}</a>
        </div>
      )}
    </div>
    <div class="container">
      <div class="footer-base"><p>&copy; <span data-year>{year}</span> {settings.siteName}. All rights reserved.</p></div>
    </div>
  </footer>

  <script is:inline src="/site.js" defer></script>
  <slot name="scripts" />
</body>
</html>
