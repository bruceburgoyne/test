---
import Layout from '../layouts/Layout.astro';
import { getContactPage, getSiteSettings } from '../lib/content.js';

const page = await getContactPage();
const settings = await getSiteSettings();
const tel = settings.phone?.replace(/[^\d+]/g, '');
---
<Layout title="Contact" description={page.seoDescription} current="contact" showHeaderCta={false}>
  <section class="page-hero">
    <div class="container">
      {page.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
      <h1>{page.headline}</h1>
      {page.intro && <p class="lead">{page.intro}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="reveal">
        <ul class="details">
          {settings.email && (
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <div><span class="details-label">Email</span><a href={`mailto:${settings.email}`}>{settings.email}</a></div>
            </li>
          )}
          {settings.phone && (
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <div><span class="details-label">Phone</span>{tel ? <a href={`tel:${tel}`}>{settings.phone}</a> : settings.phone}</div>
            </li>
          )}
          {settings.address && (
            <li>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <div><span class="details-label">Office</span>{settings.address}</div>
            </li>
          )}
        </ul>

        {page.steps.length > 0 && (
          <>
            <h2 class="aside-title">{page.stepsHeading}</h2>
            <ol class="steps">
              {page.steps.map((step) => <li><span><strong>{step.title}</strong> {step.description}</span></li>)}
            </ol>
          </>
        )}
      </div>

      <div class="form-card reveal">
        <form id="contact-form" class="form" novalidate>
          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required maxlength="200" aria-describedby="name-error">
            <p class="field-error" id="name-error"></p>
          </div>
          <div class="field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="320" aria-describedby="email-error">
            <p class="field-error" id="email-error"></p>
          </div>
          <div class="field">
            <label for="message">How can we help?</label>
            <p class="field-hint" id="message-hint">A few lines on your organisation and what you are hoping to achieve.</p>
            <textarea id="message" name="message" rows="6" required maxlength="5000" aria-describedby="message-hint message-error"></textarea>
            <p class="field-error" id="message-error"></p>
          </div>
          <!-- Honeypot: hidden from people, often filled in by bots -->
          <div class="hp" aria-hidden="true">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" tabindex="-1" autocomplete="off">
          </div>
          <div>
            <button class="button" type="submit">Send message</button>
          </div>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <script is:inline slot="scripts" src="/contact.js" defer></script>
</Layout>
