---
import Layout from '../layouts/Layout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import { getHomePage, imageUrl, imageDimensions } from '../lib/content.js';

const page = await getHomePage();
const number = (i) => String(i + 1).padStart(2, '0');

const hero = page.heroImage?.asset
  ? {
      src: imageUrl(page.heroImage, 1600),
      srcset: [800, 1200, 1600, 2000].map((w) => `${imageUrl(page.heroImage, w)} ${w}w`).join(', '),
      alt: page.heroImage.alt ?? '',
      ...imageDimensions(page.heroImage),
    }
  : {
      src: '/images/hero.jpg',
      srcset: undefined,
      alt: 'A team talking around a wooden table in a bright office kitchen',
      width: 1600,
      height: 900,
    };
---
<Layout title="Home" description={page.seoDescription} current="home">
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-content">
        {page.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
        <h1>{page.headline}{page.headlineEmphasis && <> <em>{page.headlineEmphasis}</em></>}</h1>
        {page.intro && <p class="lead">{page.intro}</p>}
        <div class="button-row">
          <a class="button" href="/contact">
            Start a conversation
            <ArrowIcon />
          </a>
          <a class="text-link" href="/about">How we work</a>
        </div>
      </div>
      <figure class="hero-media">
        <img
          src={hero.src}
          srcset={hero.srcset}
          sizes="(min-width: 960px) 50vw, 100vw"
          width={hero.width}
          height={hero.height}
          alt={hero.alt}
          fetchpriority="high"
          decoding="async"
        >
      </figure>
    </div>
  </section>

  {page.stats.length > 0 && (
    <section aria-label="At a glance">
      <div class="container">
        <dl class="stats">
          {page.stats.map((stat) => <div class="stat"><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}
        </dl>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        {page.servicesEyebrow && <p class="eyebrow">{page.servicesEyebrow}</p>}
        <h2>{page.servicesHeading}</h2>
      </div>
      <ol class="index-list">
        {page.services.map((service, i) => (
          <li class="index-item reveal">
            <span class="index-num">{number(i)}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {page.quote?.text && (
    <section class="section">
      <div class="container narrow">
        <figure class="pull-quote reveal">
          <blockquote><p>{page.quote.text}</p></blockquote>
          {page.quote.attribution && <figcaption>{page.quote.attribution}</figcaption>}
        </figure>
      </div>
    </section>
  )}

  <CtaBand heading={page.cta.heading} text={page.cta.text} />
</Layout>
